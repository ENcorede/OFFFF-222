@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    o = offers.get(oid)

    if not o:
        await cb.answer(t(cb.from_user.id, "offer_not_found"), show_alert=True)
        return

    if o["status"] != "pending":
        await cb.answer(t(cb.from_user.id, "offer_closed"), show_alert=True)
        return

    o["status"] = "rejected"

    try:
        await cb.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass

    await cb.answer(t(cb.from_user.id, "btn_reject"))


