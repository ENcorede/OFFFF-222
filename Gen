@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()

    user = message.from_user
    if not user:
        return

    uid = user.id
    started_users.add(uid)

    if user.username:
        username_to_id[user.username.lower()] = uid

    # Эмодзи отправляется отдельно.
    try:
        await message.answer(e("🔷"))
    except Exception:
        logger.exception("Ошибка отправки стартового эмодзи")

    # Меню отправляется ВСЕМ пользователям.
    # У обычных пользователей здесь нет проверки verified_handles.
    try:
        await message.answer(
            e(WELCOME),
            reply_markup=main_menu_kb()
        )
    except Exception:
        logger.exception("Ошибка меню с премиум-эмодзи")

        # Резервное меню без форматирования и custom emoji.
        try:
            await message.answer(
                "Добро пожаловать!\n\n"
                "Создавайте офферы и отправляйте предложения "
                "другим пользователям.\n\n"
                "После сделки свяжитесь с администратором "
                "по вопросам выплаты.",
                reply_markup=main_menu_kb(),
                parse_mode=None
            )
        except Exception:
            logger.exception("Не удалось отправить главное меню")

    username = (user.username or "").lower()

    if username in pending_offers:
        for oid in list(pending_offers[username]):
            offer = offers.get(oid)

            if offer and offer["status"] == "pending":
                try:
                    await send_offer_to_recipient(uid, oid)
                except Exception:
                    logger.exception(
                        "Ошибка доставки оффера %s",
                        oid
                    )

        pending_offers.pop(username, None)


