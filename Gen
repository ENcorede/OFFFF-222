@dp.inline_query()
async def inline_offer(query: InlineQuery):
    payload = (query.query or "").strip()

    if not payload.startswith("offer_"):
        await query.answer([], cache_time=1, is_personal=True)
        return

    oid = payload[len("offer_"):]
    offer = offers.get(oid)

    if not offer or offer["status"] != "pending":
        await query.answer([], cache_time=1, is_personal=True)
        return

    if query.from_user.id != offer["creator_id"]:
        await query.answer([], cache_time=1, is_personal=True)
        return

    text = make_share_text(oid)

    result = InlineQueryResultArticle(
        id=oid,
        title=f"Оффер: {offer['amount']} {currency_name(offer['currency'])}",
        description=f"Подарок: {offer['link'][:80]}",
        input_message_content=InputTextMessageContent(
            message_text=e(text),
            parse_mode=ParseMode.HTML
        ),
        reply_markup=recipient_kb(oid)
    )

    await query.answer(
        results=[result],
        cache_time=1,
        is_personal=True
    )


# =========================================================
# ОТКЛОНЕНИЕ ОФФЕРА
# =========================================================

@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer:
        await cb.answer("Оффер не найден.", show_alert=True)
        return

    if offer["status"] != "pending":
        await cb.answer("Оффер уже закрыт.", show_alert=True)
        return

    offer["status"] = "rejected"

    await safe_edit_message(
        cb,
        "✖️ Оффер отклонён.\n\n"
        f"Номер оффера: {esc(oid)}",
        reply_markup=None
    )

    await notify_creator(
        offer,
        "✖️ Ваш оффер отклонён.\n\n"
        f"Оффер: {esc(oid)}\n"
        f"Получатель: @{esc(cb.from_user.username or str(cb.from_user.id))}"
    )

    await cb.answer("Оффер отклонён.")


# =========================================================
# ПРИНЯТИЕ ОФФЕРА
# =========================================================

@dp.callback_query(F.data.startswith("accept:"))
async def cb_accept(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer:
        await cb.answer("Оффер не найден.", show_alert=True)
        return

    if offer["status"] != "pending":
        await cb.answer("Оффер уже закрыт.", show_alert=True)
        return

    # Если оффер адресован конкретному пользователю,
    # принимающий должен совпадать с ним.
    expected_username = offer.get("recipient_username", "")
    actual_username = (cb.from_user.username or "").lower()

    if expected_username and actual_username != expected_username:
        await cb.answer(
            "Этот оффер предназначен другому пользователю.",
            show_alert=True
        )
        return

    offer["status"] = "accepted"
    offer["accepted_by"] = cb.from_user.id

    text = make_deal_text(offer)

    await safe_edit_message(
        cb,
        e(text),
        reply_markup=transfer_kb(oid)
    )

    await notify_creator(
        offer,
        "✅ Ваш оффер принят!\n\n"
        f"Номер сделки: {esc(offer['deal_id'])}\n"
        f"Сумма: {offer['amount']} "
        f"{esc(currency_name(offer['currency']))}\n"
        "Проверьте условия сделки и оплату перед передачей подарка."
    )

    await cb.answer("Оффер принят!")


# =========================================================
# ПОДТВЕРЖДЕНИЕ ПЕРЕДАЧИ
# =========================================================

@dp.callback_query(F.data.startswith("transfer:"))
async def cb_transfer(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer:
        await cb.answer("Оффер не найден.", show_alert=True)
        return

    if offer["status"] != "accepted":
        await cb.answer(
            "Сделка не находится на этапе передачи.",
            show_alert=True
        )
        return

    if cb.from_user.id != offer.get("accepted_by"):
        await cb.answer(
            "Подтвердить передачу может только принявший оффер.",
            show_alert=True
        )
        return

    # Эта кнопка фиксирует только нажатие в боте.
    # Она не проверяет реальную передачу NFT и не подтверждает оплату.
    offer["status"] = "transfer_reported"

    await safe_edit_message(
        cb,
        "📜 Передача отмечена пользователем.\n\n"
        f"Заказ #{esc(offer['deal_id'])}\n\n"
        "Бот не проверил фактическую передачу NFT или оплату. "
        "Перед закрытием сделки убедитесь, что все условия выполнены.",
        reply_markup=None
    )

    await notify_creator(
        offer,
        "📜 Получатель отметил передачу по сделке.\n\n"
        f"Заказ #{esc(offer['deal_id'])}\n"
        "Это уведомление не является подтверждением оплаты."
    )

    for admin_id in ADMINS:
        try:
            await bot.send_message(
                admin_id,
                "📜 Пользователь отметил передачу по сделке.\n"
                f"Оффер: {esc(oid)}\n"
                f"Заказ: {esc(offer['deal_id'])}\n"
                f"Сумма: {offer['amount']} "
                f"{esc(currency_name(offer['currency']))}\n"
                f"Создатель ID: {offer['creator_id']}\n"
                f"Получатель ID: {offer['accepted_by']}\n\n"
                "Требуется ручная проверка."
            )
        except Exception:
            logger.exception("Не удалось уведомить администратора")

    await cb.answer("Статус передачи обновлён.")


