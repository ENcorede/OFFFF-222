def e(text: str) -> str:
    for emoji in sorted(EMOJI_MAP, key=len, reverse=True):
        text = text.replace(
            emoji,
            f'<tg-emoji emoji-id="{EMOJI_MAP[emoji]}">{emoji}</tg-emoji>'
        )
    return text


