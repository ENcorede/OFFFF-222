def gen_id(n=8):
    return "TG-" + "".join(
        random.choices(string.ascii_uppercase + string.digits, k=n)
    )


def offer_text(offer_id, lang):
    o = offers.get(offer_id)
    if not o:
        return TEXTS[lang]["share_expired"]

    return TEXTS[lang]["offer_to_recipient"].format(
        amount=o["amount"],
        currency=o["currency"],
        link=o["link"]
    )


