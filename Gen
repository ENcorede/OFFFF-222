# В этой версии языки хранятся в памяти и сбрасываются при перезапуске.
user_langs = {}


def get_lang(uid) -> str:
    return user_langs.get(uid, "ru")


def t(uid, key: str, **kwargs) -> str:
    lang = get_lang(uid)
    result = TEXTS.get(lang, TEXTS["ru"]).get(key, TEXTS["ru"].get(key, key))
    if kwargs:
        try:
            result = result.format(**kwargs)
        except (KeyError, IndexError):
            pass
    return result


