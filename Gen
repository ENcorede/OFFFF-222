async def send_offer_to_recipient(recipient_id, oid):
    offer = offers.get(oid)
    if not offer:
        return

    text = (
        "✈️ Вам поступил оффер!\n\n"
        f"Пользователь @{offer['creator_username']} предлагает:\n\n"
        f"👛 Сумма: {offer['amount']} {offer['currency']}\n"
        f"🎁 Подарок:\n{offer['link']}\n\n"
        "Выберите действие:"
    )

    await bot.send_message(
        recipient_id,
        e(text),
        reply_markup=recipient_kb(oid)
    )


@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()

    uid = message.from_user.id
    started_users.add(uid)

    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = uid

    await message.answer(e("🔷"))
    await message.answer(e(WELCOME), reply_markup=main_menu_kb())

    username = (message.from_user.username or "").lower()

    if username in pending_offers:
        for oid in list(pending_offers[username]):
            offer = offers.get(oid)
            if offer and offer["status"] == "pending":
                try:
                    await send_offer_to_recipient(uid, oid)
                except Exception:
                    pass

        pending_offers.pop(username, None)


@dp.callback_query(F.data == "create_offer")
async def cb_create_offer(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id

    if uid not in ADMINS:
        username = (cb.from_user.username or "").lower()

        if username not in verified_handles:
            await cb.answer(
                "Вы не верифицированы для создания офферов. "
                "Заявка отправлена администраторам.",
                show_alert=True
            )

            for admin_id in ADMINS:
                try:
                    await cb.bot.send_message(
                        admin_id,
                        f"Запрос на доступ к созданию офферов.\n"
                        f"Пользователь: @{cb.from_user.username or uid}\n"
                        f"ID: {uid}"
                    )
                except Exception:
                    pass

            return

    await state.set_state(OfferFlow.username)
    await cb.message.edit_text(
        e(T_USERNAME),
        reply_markup=back_kb("main")
    )
    await cb.answer()


@dp.callback_query(F.data == "exit_main")
async def cb_exit_main(cb: CallbackQuery, state: FSMContext):
    await state.clear()

    try:
        await cb.message.delete()
    except Exception:
        pass

    await cb.answer()


@dp.callback_query(F.data.startswith("back:"))
async def cb_back(cb: CallbackQuery, state: FSMContext):
    target = cb.data.split(":", 1)[1]

    if target == "main":
        await state.clear()
        await cb.message.edit_text(
            e(WELCOME),
            reply_markup=main_menu_kb()
        )

    elif target == "username":
        await state.set_state(OfferFlow.username)
        await cb.message.edit_text(
            e(T_USERNAME),
            reply_markup=back_kb("main")
        )

    elif target == "link":
        await state.set_state(OfferFlow.link)
        await cb.message.edit_text(
            e(T_LINK),
            reply_markup=back_kb("username")
        )

    elif target == "currency":
        await state.set_state(OfferFlow.currency)
        await cb.message.edit_text(
            e(T_CURRENCY),
            reply_markup=currency_kb()
        )

    elif target == "amount":
        await state.set_state(OfferFlow.amount)
        await cb.message.edit_text(
            e(T_AMOUNT),
            reply_markup=back_kb("currency")
        )

    await cb.answer()


@dp.message(OfferFlow.username)
async def msg_username(message: Message, state: FSMContext):
    text = (message.text or "").strip()

    if not text.startswith("@") or len(text) < 2:
        await message.answer("Пришлите @username.")
        return

    await state.update_data(recipient=text)
    await state.set_state(OfferFlow.link)

    await message.answer(
        e(T_LINK),
        reply_markup=back_kb("username")
    )


@dp.message(OfferFlow.link)
async def msg_link(message: Message, state: FSMContext):
    link = (message.text or "").strip()

    if not link:
        await message.answer(e(T_LINK))
        return

    await state.update_data(link=link)
    await state.set_state(OfferFlow.currency)

    await message.answer(
        e(T_CURRENCY),
        reply_markup=currency_kb()
    )


@dp.callback_query(F.data.startswith("cur:"))
async def cb_currency(cb: CallbackQuery, state: FSMContext):
    currency = cb.data.split(":", 1)[1]

    if currency not in CURRENCIES:
        await cb.answer("Неизвестная валюта.", show_alert=True)
        return

    await state.update_data(currency=currency)
    await state.set_state(OfferFlow.amount)

    await cb.message.edit_text(
        e(T_AMOUNT),
        reply_markup=back_kb("currency")
    )
    await cb.answer()


@dp.message(OfferFlow.amount)
async def msg_amount(message: Message, state: FSMContext):
    text = (message.text or "").strip()

    if not text.isdigit():
        await message.answer("Введите целое число.")
        return

    amount = int(text)

    if amount <= 0:
        await message.answer("Сумма должна быть больше нуля.")
        return

    await state.update_data(amount=amount)
    await state.set_state(OfferFlow.confirm)

    data = await state.get_data()

    preview = (
        f"{T_CONFIRM}\n\n"
        f"Получатель: {data['recipient']}\n"
        f"Подарок:\n{data['link']}\n"
        f"Сумма: {data['amount']} {data['currency']}"
    )

    await message.answer(
        e(preview),
        reply_markup=confirm_kb()
    )


@dp.callback_query(F.data == "confirm_offer")
async def cb_confirm(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id
    data = await state.get_data()

    required = ("amount", "recipient", "link", "currency")

    if not data or any(key not in data for key in required):
        await cb.answer(
            "Данные оффера потеряны. Создайте его заново.",
            show_alert=True
        )
        return

    oid = gen_id()

    offer = {
        "id": oid,
        "creator_id": uid,
        "creator_username": cb.from_user.username or str(uid),
        "recipient": data["recipient"],
        "link": data["link"],
        "currency": data["currency"],
        "amount": data["amount"],
        "status": "pending",
    }

    offers[oid] = offer
    await state.clear()

    username = data["recipient"].lstrip("@").lower()
    recipient_id = username_to_id.get(username)

    if recipient_id:
        try:
            await send_offer_to_recipient(recipient_id, oid)
        except Exception:
            pending_offers.setdefault(username, []).append(oid)
    else:
        pending_offers.setdefault(username, []).append(oid)

    notify = (
        "✈️ Оффер создан!\n\n"
        f"Получатель: {data['recipient']}\n"
        f"Сумма: {data['amount']} {data['currency']}\n"
        f"Подарок:\n{data['link']}\n\n"
        "Вы можете поделиться оффером с другим пользователем."
    )

    await cb.message.edit_text(
        e(notify),
        reply_markup=share_kb(oid)
    )
    await cb.answer("Оффер создан!")


@dp.inline_query()
async def inline_offer(query: InlineQuery):
    payload = (query.query or "").strip()

    if not payload.startswith("offer_"):
        await query.answer([], cache_time=1, is_personal=True)
        return

    oid = payload[len("offer_"):]
    offer = offers.get(oid)

    if not offer or offer["status"] != "pending":
        await query.answer([], cache_time=1, is_personal=True)
        return

    # Только создатель может сформировать результат для публикации.
    if query.from_user.id != offer["creator_id"]:
        await query.answer([], cache_time=1, is_personal=True)
        return

    text = make_share_text(oid)

    result = InlineQueryResultArticle(
        id=oid,
        title=f"Оффер: {offer['amount']} {offer['currency']}",
        description=f"Подарок: {offer['link'][:80]}",
        input_message_content=InputTextMessageContent(
            message_text=e(text),
            parse_mode=ParseMode.HTML
        ),
        reply_markup=recipient_kb(oid)
    )

    await query.answer(
        results=[result],
        cache_time=1,
        is_personal=True
    )


@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer:
        await cb.answer("Оффер не найден.", show_alert=True)
        return

    if offer["status"] != "pending":
        await cb.answer("Оффер уже закрыт.", show_alert=True)
        return

    offer["status"] = "rejected"

    try:
        await cb.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass

    await cb.answer("Оффер отклонён.")


