async def deliver_pending(uid, username):
    if not username:
        return

    uname = username.lower()
    for oid in list(pending_offers.get(uname, [])):
        if oid not in offers or offers[oid]["status"] != "pending":
            continue
        try:
            await bot.send_message(
                uid,
                e(offer_text(oid, offers[oid]["offer_language"])),
                reply_markup=offer_actions_kb(
                    oid, offers[oid]["offer_language"]
                )
            )
        except Exception:
            continue

    pending_offers.pop(uname, None)


@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    uid = message.from_user.id
    started_users.add(uid)

    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = uid

    if uid not in user_langs:
        await message.answer(
            TEXTS["ru"]["choose_language"],
            reply_markup=language_kb()
        )
        return

    await message.answer(
        e(t(uid, "welcome")),
        reply_markup=main_menu_kb(uid)
    )
    await deliver_pending(uid, message.from_user.username)


@dp.callback_query(F.data.startswith("lang:"))
async def cb_lang(cb: CallbackQuery):
    code = cb.data.split(":", 1)[1]
    if code not in LANGUAGES:
        await cb.answer()
        return

    uid = cb.from_user.id
    user_langs[uid] = code
    started_users.add(uid)

    if cb.from_user.username:
        username_to_id[cb.from_user.username.lower()] = uid

    await cb.message.edit_text(
        e(t(uid, "welcome")),
        reply_markup=main_menu_kb(uid)
    )
    await cb.answer(t(uid, "language_changed"))
    await deliver_pending(uid, cb.from_user.username)


@dp.callback_query(F.data.startswith("offerlang:"))
async def cb_offerlang(cb: CallbackQuery, state: FSMContext):
    code = cb.data.split(":", 1)[1]
    if code not in LANGUAGES:
        await cb.answer()
        return

    await state.update_data(offer_language=code)
    uid = cb.from_user.id

    data = await state.get_data()
    oid = gen_id()
    offer = {
        "id": oid,
        "creator_id": uid,
        "creator_username": cb.from_user.username or str(uid),
        "recipient": data["recipient"],
        "link": data["link"],
        "currency": data["currency"],
        "amount": data["amount"],
        "offer_language": code,
        "status": "pending",
        "accepted_by": None,
    }
    offers[oid] = offer

    recipient = data["recipient"].lstrip("@").lower()
    rid = username_to_id.get(recipient)

    if rid:
        try:
            await bot.send_message(
                rid,
                e(offer_text(oid, code)),
                reply_markup=offer_actions_kb(oid, code)
            )
        except Exception:
            pending_offers.setdefault(recipient, []).append(oid)
    else:
        pending_offers.setdefault(recipient, []).append(oid)

    await state.clear()

    await cb.message.edit_text(
        e(t(uid, "offer_created")),
        reply_markup=share_kb(oid)
    )
    await cb.answer()


@dp.callback_query(F.data == "settings")
