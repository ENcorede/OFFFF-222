@dp.callback_query(F.data.startswith("reject:"))
async def cb_reject(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer:
        await cb.answer("Оффер не найден.", show_alert=True)
        return

    if offer["status"] != "pending":
        await cb.answer("Оффер уже закрыт.", show_alert=True)
        return

    expected_username = offer.get("recipient_username", "")
    actual_username = (cb.from_user.username or "").lower()

    if expected_username and actual_username != expected_username:
        await cb.answer(
            "Этот оффер предназначен другому пользователю.",
            show_alert=True
        )
        return

    offer["status"] = "rejected"

    await safe_edit_message(
        cb,
        "Оффер отклонён.",
        reply_markup=None
    )

    await notify_creator(
        offer,
        "Ваш оффер отклонён.\n\n"
        f"Номер оффера: {oid}"
    )

    await cb.answer("Оффер отклонён.")


# =========================================================
# ПРИНЯТИЕ
# =========================================================

@dp.callback_query(F.data.startswith("accept:"))
async def cb_accept(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer:
        await cb.answer("Оффер не найден.", show_alert=True)
        return

    if offer["status"] != "pending":
        await cb.answer("Оффер уже закрыт.", show_alert=True)
        return

    expected_username = offer.get("recipient_username", "")
    actual_username = (cb.from_user.username or "").lower()

    if expected_username and actual_username != expected_username:
        await cb.answer(
            "Этот оффер предназначен другому пользователю.",
            show_alert=True
        )
        return

    if time.time() > offer.get("expires_at", 0):
        offer["status"] = "expired"

        await safe_edit_message(
            cb,
            "Срок действия оффера истёк.",
            reply_markup=None
        )

        await cb.answer("Оффер истёк.", show_alert=True)
        return

    offer["status"] = "accepted"
    offer["accepted_by"] = cb.from_user.id

    await safe_edit_message(
        cb,
        make_deal_text(offer),
        reply_markup=transfer_kb(oid)
    )

    await notify_creator(
        offer,
        "Ваш оффер принят.\n\n"
        f"Заказ #{offer['deal_id']}\n"
        f"Сумма: {offer['amount']} "
        f"{currency_name(offer['currency'])}\n\n"
        "Перед передачей подарка проверьте оплату."
    )

    await cb.answer("Оффер принят!")


# =========================================================
# TRANSFER NFT — ОТМЕТКА О ПЕРЕДАЧЕ
# =========================================================

@dp.callback_query(F.data.startswith("transfer:"))
async def cb_transfer(cb: CallbackQuery):
    oid = cb.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer:
        await cb.answer("Оффер не найден.", show_alert=True)
        return

    if offer["status"] != "accepted":
        await cb.answer(
            "Сделка не находится на этапе передачи.",
            show_alert=True
        )
        return

    if cb.from_user.id != offer.get("accepted_by"):
        await cb.answer(
            "Подтвердить передачу может только принявший оффер.",
            show_alert=True
        )
        return

    # Это только отметка пользователя, а не проверка транзакции.
    offer["status"] = "transfer_reported"

    await safe_edit_message(
        cb,
        "Передача отмечена пользователем.\n\n"
        f"Заказ #{esc(offer['deal_id'])}\n\n"
        "Бот не проверил фактическую передачу NFT или получение оплаты. "
        "Перед закрытием сделки проверьте выполнение всех условий.",
        reply_markup=None
    )

    await notify_creator(
        offer,
        "Получатель отметил передачу подарка.\n\n"
        f"Заказ #{offer['deal_id']}\n"
        "Это сообщение не является подтверждением оплаты."
    )

    for admin_id in ADMINS:
        try:
            await bot.send_message(
                admin_id,
                "Пользователь отметил передачу подарка.\n"
                f"Оффер: {oid}\n"
                f"Заказ: {offer['deal_id']}\n"
                f"Сумма: {offer['amount']} "
                f"{currency_name(offer['currency'])}\n"
                f"Создатель ID: {offer['creator_id']}\n"
                f"Получатель ID: {offer['accepted_by']}\n\n"
                "Требуется проверка сделки.",
                parse_mode=None
            )
        except Exception:
            logger.exception("Не удалось уведомить администратора")

    await cb.answer("Статус передачи обновлён.")


