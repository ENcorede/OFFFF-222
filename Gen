def e(text: str) -> str:
    for k in sorted(EMOJI_MAP, key=len, reverse=True):
        text = text.replace(
            k,
            f'<tg-emoji emoji-id="{EMOJI_MAP[k]}">{k}</tg-emoji>'
        )
    return text


