@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()

    user = message.from_user

    if not user:
        return

    uid = user.id
    started_users.add(uid)

    if user.username:
        username_to_id[user.username.lower()] = uid

    # Сначала отправляем эмодзи.
    try:
        await message.answer(e("🔷"))
    except Exception:
        logger.exception("Не удалось отправить стартовый эмодзи")

    # Затем показываем меню независимо от наличия доступа.
    try:
        await message.answer(
            e(WELCOME),
            reply_markup=main_menu_kb()
        )

    except Exception:
        logger.exception("Ошибка отправки меню с форматированием")

        try:
            await message.answer(
                "Добро пожаловать!\n\n"
                "Создавайте офферы, отправляйте предложения другим "
                "пользователям и отслеживайте сделки.\n\n"
                "По вопросам выплаты обратитесь к администратору.",
                reply_markup=main_menu_kb(),
                parse_mode=None
            )

        except Exception:
            logger.exception("Не удалось отправить главное меню")

    username = (user.username or "").lower()

    # Доставляем отложенные офферы.
    if username in pending_offers:
        for oid in list(pending_offers[username]):
            offer = offers.get(oid)

            if offer and offer["status"] == "pending":
                try:
                    await send_offer_to_recipient(uid, oid)
                except Exception:
                    logger.exception(
                        "Не удалось доставить оффер %s",
                        oid
                    )

        pending_offers.pop(username, None)


