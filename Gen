@dp.callback_query(F.data == "create_offer")
async def cb_create_offer(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id

    # Доступ проверяется только здесь, а не при /start.
    if uid not in ADMINS:
        username = (cb.from_user.username or "").lower()

        if username not in verified_handles:
            for admin_id in ADMINS:
                try:
                    await bot.send_message(
                        admin_id,
                        "Запрос на доступ к созданию офферов.\n"
                        f"Пользователь: @{esc(cb.from_user.username or str(uid))}\n"
                        f"ID: {uid}"
                    )
                except Exception:
                    logger.exception(
                        "Не удалось отправить запрос администратору"
                    )

            await cb.answer(
                "Нет доступа к созданию офферов. "
                "Запрос отправлен администраторам.",
                show_alert=True
            )
            return

    await state.set_state(OfferFlow.username)

    if cb.message:
        await cb.message.edit_text(
            e(T_USERNAME),
            reply_markup=back_kb("main")
        )

    await cb.answer()


@dp.callback_query(F.data == "exit_main")
async def cb_exit_main(cb: CallbackQuery, state: FSMContext):
    await state.clear()

    if cb.message:
        try:
            await cb.message.delete()
        except Exception:
            await safe_edit_message(cb, e(WELCOME), main_menu_kb())

    await cb.answer()


@dp.callback_query(F.data.startswith("back:"))
async def cb_back(cb: CallbackQuery, state: FSMContext):
    target = cb.data.split(":", 1)[1]

    if target == "main":
        await state.clear()
        await safe_edit_message(
            cb,
            e(WELCOME),
            main_menu_kb()
        )

    elif target == "username":
        await state.set_state(OfferFlow.username)
        await safe_edit_message(
            cb,
            e(T_USERNAME),
            back_kb("main")
        )

    elif target == "link":
        await state.set_state(OfferFlow.link)
        await safe_edit_message(
            cb,
            e(T_LINK),
            back_kb("username")
        )

    elif target == "currency":
        await state.set_state(OfferFlow.currency)
        await safe_edit_message(
            cb,
            e(T_CURRENCY),
            currency_kb()
        )

    elif target == "amount":
        await state.set_state(OfferFlow.amount)
        await safe_edit_message(
            cb,
            e(T_AMOUNT),
            back_kb("currency")
        )

    await cb.answer()


@dp.message(OfferFlow.username)
async def msg_username(message: Message, state: FSMContext):
    text = (message.text or "").strip()

    if text.startswith("https://t.me/"):
        text = "@" + text.removeprefix("https://t.me/").split("/")[0]

    if text.startswith("t.me/"):
        text = "@" + text.removeprefix("t.me/").split("/")[0]

    username = text.lstrip("@").split("/")[0].split("?")[0]

    if not username or not all(
        char.isalnum() or char == "_" for char in username
    ):
        await message.answer("Пришлите корректный @username.")
        return

    if len(username) < 5 or len(username) > 32:
        await message.answer("Проверьте длину username и отправьте его снова.")
        return

    await state.update_data(recipient="@" + username)
    await state.set_state(OfferFlow.link)

    await message.answer(
        e(T_LINK),
        reply_markup=back_kb("username")
    )


@dp.message(OfferFlow.link)
async def msg_link(message: Message, state: FSMContext):
    link = (message.text or "").strip()

    if not link:
        await message.answer(e(T_LINK))
        return

    links = [line.strip() for line in link.splitlines() if line.strip()]

    if not links:
        await message.answer(e(T_LINK))
        return

    if any(
        not item.startswith(("https://t.me/", "http://t.me/", "t.me/"))
        for item in links
    ):
        await message.answer(
            "Отправьте ссылку на подарок в формате t.me/..."
        )
        return

    await state.update_data(link="\n".join(links))
    await state.set_state(OfferFlow.currency)

    await message.answer(
        e(T_CURRENCY),
        reply_markup=currency_kb()
    )


@dp.callback_query(F.data.startswith("cur:"))
async def cb_currency(cb: CallbackQuery, state: FSMContext):
    currency = cb.data.split(":", 1)[1]

    if currency not in CURRENCIES:
        await cb.answer("Неизвестная валюта.", show_alert=True)
        return

    await state.update_data(currency=currency)
    await state.set_state(OfferFlow.amount)

    await safe_edit_message(
        cb,
        e(T_AMOUNT),
        back_kb("currency")
    )

    await cb.answer()


@dp.message(OfferFlow.amount)
async def msg_amount(message: Message, state: FSMContext):
    text = (message.text or "").strip()

    if not text.isdigit():
        await message.answer("Введите сумму целым положительным числом.")
        return

    amount = int(text)

    if amount <= 0:
        await message.answer("Сумма должна быть больше нуля.")
        return

    await state.update_data(amount=amount)
    await state.set_state(OfferFlow.confirm)

    data = await state.get_data()

    preview = (
        f"{T_CONFIRM}\n\n"
        f"Получатель: {esc(data['recipient'])}\n"
        f"Подарок:\n{esc(data['link'])}\n"
        f"Сумма: {amount} {esc(currency_name(data['currency']))}"
    )

    await message.answer(
        e(preview),
        reply_markup=confirm_kb()
    )


@dp.callback_query(F.data == "confirm_offer")
async def cb_confirm(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id
    data = await state.get_data()

    required = ("amount", "recipient", "link", "currency")

    if not data or any(key not in data for key in required):
        await cb.answer(
            "Данные оффера потеряны. Создайте его заново.",
            show_alert=True
        )
        return

    oid = gen_id()
    recipient_username = data["recipient"].lstrip("@").lower()

    offer = {
        "id": oid,
        "deal_id": gen_id(),
        "creator_id": uid,
        "creator_username": cb.from_user.username or str(uid),
        "recipient": data["recipient"],
        "recipient_username": recipient_username,
        "recipient_id": username_to_id.get(recipient_username),
        "link": data["link"],
        "currency": data["currency"],
        "amount": data["amount"],
        "status": "pending",
        "accepted_by": None,
    }

    offers[oid] = offer
    await state.clear()

    recipient_id = offer["recipient_id"]

    if recipient_id:
        try:
            await send_offer_to_recipient(recipient_id, oid)
        except Exception:
            logger.exception("Не удалось отправить оффер напрямую")
            pending_offers.setdefault(recipient_username, []).append(oid)
    else:
        pending_offers.setdefault(recipient_username, []).append(oid)

    notify = (
        "✈️ Оффер создан!\n\n"
        f"Получатель: {esc(data['recipient'])}\n"
        f"Сумма: {data['amount']} "
        f"{esc(currency_name(data['currency']))}\n"
        f"Подарок:\n{esc(data['link'])}\n\n"
        "Нажмите «Поделиться оффером», чтобы отправить его "
        "в чат Telegram."
    )

    await safe_edit_message(
        cb,
        e(notify),
        share_kb(oid)
    )

    await cb.answer("Оффер создан!")


