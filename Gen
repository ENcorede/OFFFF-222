@dp.message(Command("dostup"))
async def grant_access(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = (message.text or "").split(maxsplit=1)

    if len(parts) != 2:
        await message.answer("Использование: /dostup @username")
        return

    username = parts[1].strip().lstrip("@").lower()
    verified_handles.add(username)

    await message.answer(f"Доступ выдан @{username}")


@dp.message(Command("undostup"))
async def revoke_access(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = (message.text or "").split(maxsplit=1)

    if len(parts) != 2:
        await message.answer("Использование: /undostup @username")
        return

    username = parts[1].strip().lstrip("@").lower()
    verified_handles.discard(username)

    await message.answer(f"Доступ снят с @{username}")


@dp.message(Command("offers"))
async def list_offers(message: Message):
    if message.from_user.id not in ADMINS:
        return

    if not offers:
        await message.answer("Офферов пока нет.")
        return

    lines = ["Офферы:"]

    for oid, offer in offers.items():
        lang = offer["offer_language"]
        currency = currency_name(offer["currency"], lang)

        lines.append(
            f"{oid} | {offer['status']} | "
            f"{offer['amount']} {currency} | "
            f"@{offer['recipient'].lstrip('@')}"
        )

    await message.answer("\n".join(lines), parse_mode=None)


@dp.message(Command("m"))
async def broadcast(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = (message.text or "").split(maxsplit=1)

    if len(parts) != 2:
        await message.answer("Использование: /m текст")
        return

    sent = 0

    for uid in list(started_users):
        try:
            await bot.send_message(uid, parts[1], parse_mode=None)
            sent += 1
        except Exception:
            pass

    await message.answer(f"Отправлено: {sent}")


