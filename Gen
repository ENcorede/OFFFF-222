@dp.callback_query(F.data == "confirm_offer")
async def cb_confirm(cb: CallbackQuery, state: FSMContext):
    uid = cb.from_user.id
    data = await state.get_data()

    required = ("amount", "recipient", "link", "currency")

    if not data or any(key not in data for key in required):
        await cb.answer()
        return

    await state.clear()

    oid = gen_id()

    offer = {
        "id": oid,
        "creator_id": uid,
        "creator_username": cb.from_user.username or str(uid),
        "recipient": data["recipient"],
        "link": data["link"],
        "currency": data["currency"],
        "amount": data["amount"],
        "status": "pending",
    }

    offers[oid] = offer

    recipient_username = data["recipient"].lstrip("@").lower()
    recipient_id = username_to_id.get(recipient_username)

    if recipient_id:
        try:
            await send_offer_to_recipient(cb.bot, recipient_id, oid)
        except Exception:
            pending_offers.setdefault(recipient_username, []).append(oid)
    else:
        pending_offers.setdefault(recipient_username, []).append(oid)

    notify = t(
        uid,
        "notify_sent",
        creator=offer["creator_username"],
        amount=offer["amount"],
        currency=offer["currency"],
        recipient=data["recipient"]
    )

    await cb.message.edit_text(
        e(notify),
        reply_markup=share_kb(uid, oid)
    )

    await cb.answer()


@dp.message(OfferFlow.username)
