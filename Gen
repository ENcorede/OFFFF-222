@dp.message(Command("dostup"))
async def cmd_dostup(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = (message.text or "").split(maxsplit=1)

    if len(parts) < 2:
        await message.answer("Использование: /dostup @username")
        return

    username = parts[1].strip().lstrip("@").lower()

    if not username:
        await message.answer("Укажите username.")
        return

    verified_handles.add(username)

    await message.answer(
        f"Доступ к созданию офферов выдан @{esc(username)}"
    )


@dp.message(Command("undostup"))
async def cmd_undostup(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = (message.text or "").split(maxsplit=1)

    if len(parts) < 2:
        await message.answer("Использование: /undostup @username")
        return

    username = parts[1].strip().lstrip("@").lower()
    verified_handles.discard(username)

    await message.answer(
        f"Доступ к созданию офферов снят с @{esc(username)}"
    )


@dp.message(Command("m"))
async def cmd_m(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = (message.text or "").split(maxsplit=1)

    if len(parts) < 2:
        await message.answer("Использование: /m текст")
        return

    sent = 0

    for uid in list(started_users):
        try:
            await bot.send_message(
                uid,
                parts[1],
                parse_mode=None
            )
            sent += 1
        except Exception:
            logger.exception("Не удалось отправить сообщение %s", uid)

    await message.answer(f"Отправлено: {sent}")


@dp.message(Command("offers"))
async def cmd_offers(message: Message):
    if message.from_user.id not in ADMINS:
        return

    active = {
        oid: offer
        for oid, offer in offers.items()
        if offer["status"] in ("pending", "accepted")
    }

    if not active:
        await message.answer("Активных офферов нет.")
        return

    lines = ["Активные офферы:"]

    for oid, offer in active.items():
        lines.append(
            f"#{oid} | @{offer['creator_username']} → "
            f"{offer['recipient']} | {offer['amount']} "
            f"{currency_name(offer['currency'])} | {offer['status']}"
        )

    await message.answer(
        "\n".join(lines),
        parse_mode=None
    )


