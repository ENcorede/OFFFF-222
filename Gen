@dp.message(CommandStart())
async def start(message: Message, state: FSMContext):
    await state.clear()

    uid = message.from_user.id
    started_users.add(uid)

    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = uid

    if uid not in user_langs:
        await message.answer(
            TEXTS["ru"]["choose_language"],
            reply_markup=language_kb()
        )
        return

    lang = get_lang(uid)

    await message.answer(
        e(tr(lang, "welcome")),
        reply_markup=main_menu_kb(uid)
    )

    await send_pending_offers(uid, message.from_user.username)


@dp.callback_query(F.data.startswith("lang:"))
async def set_language(callback: CallbackQuery):
    uid = callback.from_user.id
    lang = callback.data.split(":", 1)[1]

    if lang not in LANGUAGES:
        await callback.answer()
        return

    user_langs[uid] = lang
    started_users.add(uid)

    if callback.from_user.username:
        username_to_id[callback.from_user.username.lower()] = uid

    await callback.message.edit_text(
        e(tr(lang, "welcome")),
        reply_markup=main_menu_kb(uid)
    )

    await callback.answer(tr(lang, "language_changed"))

    await send_pending_offers(uid, callback.from_user.username)


@dp.callback_query(F.data == "settings")
async def settings(callback: CallbackQuery):
    uid = callback.from_user.id
    lang = get_lang(uid)

    await callback.message.edit_text(
        tr(lang, "choose_language"),
        reply_markup=language_kb(prefix="lang", lang=lang)
    )

    await callback.answer()


@dp.callback_query(F.data == "back:main")
async def back_main(callback: CallbackQuery, state: FSMContext):
    await state.clear()
    uid = callback.from_user.id
    lang = get_lang(uid)

    await callback.message.edit_text(
        e(tr(lang, "welcome")),
        reply_markup=main_menu_kb(uid)
    )

    await callback.answer()


@dp.callback_query(F.data == "exit")
async def exit_menu(callback: CallbackQuery, state: FSMContext):
    await state.clear()

    try:
        await callback.message.delete()
    except Exception:
        pass

    await callback.answer()


# =========================================================
# CREATE OFFER
# =========================================================

@dp.callback_query(F.data == "create_offer")
async def create_offer(callback: CallbackQuery, state: FSMContext):
    uid = callback.from_user.id
    lang = get_lang(uid)
    username = (callback.from_user.username or "").lower()

    if uid not in ADMINS and username not in verified_handles:
        await callback.answer(
            tr(lang, "no_access"),
            show_alert=True
        )

        for admin_id in ADMINS:
            try:
                await bot.send_message(
                    admin_id,
                    f"Запрос доступа от @{callback.from_user.username or uid} "
                    f"(ID: {uid})."
                )
            except Exception:
                pass

        return

    await state.set_state(OfferFlow.username)

    await callback.message.edit_text(
        e(tr(lang, "enter_username")),
        reply_markup=InlineKeyboardMarkup(inline_keyboard=[[
            InlineKeyboardButton(
                text=tr(lang, "back"),
                callback_data="back:main"
            )
        ]])
    )

    await callback.answer()


@dp.message(OfferFlow.username)
async def enter_username(message: Message, state: FSMContext):
    uid = message.from_user.id
    lang = get_lang(uid)
    recipient = (message.text or "").strip()

    if not recipient.startswith("@") or len(recipient) < 2:
        await message.answer(tr(lang, "invalid_username"))
        return

    await state.update_data(recipient=recipient)
    await state.set_state(OfferFlow.link)

    await message.answer(e(tr(lang, "enter_link")))


@dp.message(OfferFlow.link)
async def enter_link(message: Message, state: FSMContext):
    uid = message.from_user.id
    lang = get_lang(uid)
    link = (message.text or "").strip()

    if not link:
        await message.answer(tr(lang, "enter_link"))
        return

    await state.update_data(link=link)
    await state.set_state(OfferFlow.currency)

    await message.answer(
        e(tr(lang, "choose_currency")),
        reply_markup=currency_kb(uid)
    )


@dp.callback_query(F.data == "back:link")
async def back_link(callback: CallbackQuery, state: FSMContext):
    uid = callback.from_user.id
    lang = get_lang(uid)

    await state.set_state(OfferFlow.link)

    await callback.message.edit_text(e(tr(lang, "enter_link")))
    await callback.answer()


@dp.callback_query(F.data.startswith("currency:"))
async def choose_currency(callback: CallbackQuery, state: FSMContext):
    currency = callback.data.split(":", 1)[1]
    uid = callback.from_user.id
    lang = get_lang(uid)

    if currency not in CURRENCIES:
        await callback.answer()
        return

    await state.update_data(currency=currency)
    await state.set_state(OfferFlow.amount)

    await callback.message.edit_text(e(tr(lang, "enter_amount")))
    await callback.answer()


@dp.message(OfferFlow.amount)
async def enter_amount(message: Message, state: FSMContext):
    uid = message.from_user.id
    lang = get_lang(uid)
    raw = (message.text or "").strip()

    if not raw.isdigit() or int(raw) <= 0:
        await message.answer(tr(lang, "invalid_amount"))
        return

    await state.update_data(amount=int(raw))
    await state.set_state(OfferFlow.offer_language)

    await message.answer(
        e(tr(lang, "choose_offer_language")),
        reply_markup=language_kb(prefix="offerlang")
    )


@dp.callback_query(F.data.startswith("offerlang:"))
async def choose_offer_language(callback: CallbackQuery, state: FSMContext):
    uid = callback.from_user.id
    offer_lang = callback.data.split(":", 1)[1]

    if offer_lang not in LANGUAGES:
        await callback.answer()
        return

    data = await state.get_data()

    oid = make_id()

    offer = {
        "id": oid,
        "creator_id": uid,
        "creator_username": callback.from_user.username or str(uid),
        "recipient": data["recipient"],
        "link": data["link"],
        "currency": data["currency"],
        "amount": data["amount"],
        "offer_language": offer_lang,
        "status": "pending",
        "accepted_by": None,
    }

    offers[oid] = offer

    normalized = offer["recipient"].lower().lstrip("@")
    recipient_id = username_to_id.get(normalized)

    if recipient_id:
        try:
            await bot.send_message(
                recipient_id,
                e(public_offer_text(oid)),
                reply_markup=offer_actions_kb(oid, offer_lang)
            )
        except Exception:
            pending_offers.setdefault(normalized, []).append(oid)
    else:
        pending_offers.setdefault(normalized, []).append(oid)

    await state.clear()

    await callback.message.edit_text(
        e(tr(get_lang(uid), "offer_created")),
        reply_markup=share_kb(oid)
    )

    await callback.answer()


# =========================================================
# INLINE SHARING
# =========================================================

@dp.inline_query()
async def inline_share(query: InlineQuery):
    search = (query.query or "").strip()

    if not search.startswith("offer_"):
        await query.answer([], cache_time=1, is_personal=True)
        return

    oid = search[len("offer_"):]
    offer = offers.get(oid)

    if not offer or offer["status"] != "pending":
        await query.answer([], cache_time=1, is_personal=True)
        return

    lang = offer["offer_language"]

    result = InlineQueryResultArticle(
        id=oid,
        title=tr(lang, "inline_title", oid=oid),
        description=tr(lang, "inline_description"),
        input_message_content=InputTextMessageContent(
            message_text=e(public_offer_text(oid)),
            parse_mode=ParseMode.HTML
        ),
        reply_markup=offer_actions_kb(oid, lang)
    )

    await query.answer(
        [result],
        cache_time=1,
        is_personal=True
    )


# =========================================================
# ACCEPT / REJECT
# =========================================================

@dp.callback_query(F.data.startswith("reject:"))
async def reject_offer(callback: CallbackQuery):
    oid = callback.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer or offer["status"] != "pending":
        await callback.answer(
            tr(get_lang(callback.from_user.id), "already_processed"),
            show_alert=True
        )
        return

    if callback.from_user.id == offer["creator_id"]:
        await callback.answer(
            tr(get_lang(callback.from_user.id), "not_recipient"),
            show_alert=True
        )
        return

    offer["status"] = "rejected"

    try:
        await callback.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass

    await callback.answer(
        tr(offer["offer_language"], "offer_rejected")
    )


@dp.callback_query(F.data.startswith("accept:"))
async def accept_offer(callback: CallbackQuery):
    oid = callback.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer or offer["status"] != "pending":
        await callback.answer(
            tr(get_lang(callback.from_user.id), "already_processed"),
            show_alert=True
        )
        return

    if callback.from_user.id == offer["creator_id"]:
        await callback.answer(
            tr(get_lang(callback.from_user.id), "not_recipient"),
            show_alert=True
        )
        return

    offer["status"] = "accepted"
    offer["accepted_by"] = callback.from_user.id

    lang = offer["offer_language"]

    await callback.message.edit_text(
        e(public_offer_text(oid)),
        reply_markup=transfer_kb(oid, lang)
    )

    await callback.answer()


# =========================================================
# TRANSFER CONFIRMATION AND ADMIN REVIEW
# =========================================================

@dp.callback_query(F.data.startswith("transfer:"))
async def transfer_confirm(callback: CallbackQuery):
    oid = callback.data.split(":", 1)[1]
    offer = offers.get(oid)

    if not offer or offer["status"] != "accepted":
        await callback.answer(
            tr(get_lang(callback.from_user.id), "already_processed"),
            show_alert=True
        )
        return

    if callback.from_user.id != offer["accepted_by"]:
        await callback.answer(
            tr(get_lang(callback.from_user.id), "not_recipient"),
            show_alert=True
        )
        return

    lang = offer["offer_language"]
    offer["status"] = "review"

    review_text = tr(
        lang,
        "admin_review",
        trade_id=oid,
        creator=offer["creator_username"],
        recipient=offer["recipient"].lstrip("@"),
        amount=offer["amount"],
        currency=currency_name(offer["currency"], lang),
        link=offer["link"],
        user=callback.from_user.username or callback.from_user.full_name,
        user_id=callback.from_user.id,
    )

    sent_to_admin = False

    for admin_id in ADMINS:
        try:
            await bot.send_message(admin_id, e(review_text))
            sent_to_admin = True
        except Exception:
            pass

    try:
        await callback.message.edit_text(
            e(tr(lang, "submitted"))
        )
    except Exception:
        await callback.message.answer(e(tr(lang, "submitted")))

    if sent_to_admin:
        await callback.answer(tr(lang, "admin_received"))
    else:
        await callback.answer(tr(lang, "no_admins"), show_alert=True)


