# =========================================================
# DATA
# =========================================================

user_langs = {}
verified_handles = set()
started_users = set()
username_to_id = {}
offers = {}
pending_offers = {}


def get_lang(user_id):
    return user_langs.get(user_id, "ru")


def tr(lang, key, **kwargs):
    template = TEXTS.get(lang, TEXTS["ru"]).get(
        key, TEXTS["ru"].get(key, key)
    )
    return template.format(**kwargs) if kwargs else template


def currency_name(currency, lang):
    return CURRENCIES.get(currency, {}).get(lang, currency)


def make_id():
    return "TG-" + "".join(
        random.choices(string.ascii_uppercase + string.digits, k=8)
    )


def public_offer_text(oid):
    offer = offers[oid]
    lang = offer["offer_language"]

    return tr(
        lang,
        "deal_instructions",
        trade_id=oid,
        amount=offer["amount"],
        currency=currency_name(offer["currency"], lang),
        recipient=offer["recipient"].lstrip("@"),
        link=offer["link"],
    )


# =========================================================
# BOT INITIALIZATION
# =========================================================

if not BOT_TOKEN:
    raise RuntimeError(
        "BOT_TOKEN не задан в переменных окружения Bothost."
    )

bot = Bot(
    BOT_TOKEN,
    default=DefaultBotProperties(parse_mode=ParseMode.HTML)
)

dp = Dispatcher(storage=MemoryStorage())


class OfferFlow(StatesGroup):
    username = State()
    link = State()
    currency = State()
    amount = State()
    offer_language = State()


