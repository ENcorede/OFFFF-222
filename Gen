async def send_offer_to_recipient(bot_instance, recipient_id, offer_id):
    if offer_id not in offers:
        return

    o = offers[offer_id]
    uid = recipient_id

    text = t(
        uid,
        "offer_to_recipient",
        amount=o["amount"],
        currency=o["currency"],
        link=o["link"]
    )

    await bot_instance.send_message(
        recipient_id,
        e(text),
        reply_markup=recipient_kb(uid, offer_id)
    )


def make_share_text(uid, oid):
    o = offers.get(oid)
    if not o:
        return None

    return t(
        uid,
        "share_message",
        creator=o["creator_username"],
        amount=o["amount"],
        currency=o["currency"],
        link=o["link"]
    )


@dp.inline_query()
async def inline_offer(query: InlineQuery):
    """
    Inline-режим позволяет отправить оффер из меню выбора чата.
    Inline-результат содержит только кнопки «Принять» и «Отклонить».
    """
    payload = (query.query or "").strip()

    if not payload.startswith("offer_"):
        await query.answer([], cache_time=1, is_personal=True)
        return

    oid = payload.removeprefix("offer_")
    o = offers.get(oid)

    if not o or o.get("status") != "pending":
        await query.answer([], cache_time=1, is_personal=True)
        return

    uid = query.from_user.id
    text = make_share_text(uid, oid)

    result = InlineQueryResultArticle(
        id=oid,
        title="✈️ " + t(uid, "btn_share"),
        description=f"{o['amount']} {o['currency']} — {o['link'][:80]}",
        input_message_content=InputTextMessageContent(
            message_text=e(text),
            parse_mode=ParseMode.HTML
        ),
        reply_markup=recipient_kb(uid, oid)
    )

    await query.answer(
        results=[result],
        cache_time=1,
        is_personal=True
    )


@dp.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()

    uid = message.from_user.id
    started_users.add(uid)

    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = uid

    if uid not in user_langs:
        await message.answer(
            LANG_PROMPT,
            reply_markup=language_kb()
        )
        return

    await message.answer(e("🔷"))
    await message.answer(
        e(t(uid, "welcome")),
        reply_markup=main_menu_kb(uid)
    )

    if message.from_user.username:
        uname = message.from_user.username.lower()
        if uname in pending_offers:
            for oid in list(pending_offers[uname]):
                if oid in offers and offers[oid]["status"] == "pending":
                    await send_offer_to_recipient(bot, uid, oid)
            pending_offers.pop(uname, None)


@dp.callback_query(F.data.startswith("lang:"))
async def cb_lang(cb: CallbackQuery, state: FSMContext):
    code = cb.data.split(":", 1)[1]

    if code not in LANGUAGES:
        await cb.answer()
        return

    is_first = cb.from_user.id not in user_langs
    user_langs[cb.from_user.id] = code

    uid = cb.from_user.id
    started_users.add(uid)

    if cb.from_user.username:
        username_to_id[cb.from_user.username.lower()] = uid

    await cb.message.edit_text(
        e(t(uid, "welcome")),
        reply_markup=main_menu_kb(uid)
    )
    await cb.answer(t(uid, "language_changed"))

    if is_first and cb.from_user.username:
        uname = cb.from_user.username.lower()
        if uname in pending_offers:
            for oid in list(pending_offers[uname]):
                if oid in offers and offers[oid]["status"] == "pending":
                    await send_offer_to_recipient(bot, uid, oid)
            pending_offers.pop(uname, None)


