@dp.message(Command("dostup"))
async def cmd_dostup(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = message.text.split(maxsplit=1)

    if len(parts) < 2:
        await message.answer("Использование: /dostup @username")
        return

    username = parts[1].strip().lstrip("@").lower()
    verified_handles.add(username)

    await message.answer(f"Доступ выдан @{username}")


@dp.message(Command("undostup"))
async def cmd_undostup(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = message.text.split(maxsplit=1)

    if len(parts) < 2:
        await message.answer("Использование: /undostup @username")
        return

    username = parts[1].strip().lstrip("@").lower()
    verified_handles.discard(username)

    await message.answer(f"Доступ снят с @{username}")


@dp.message(Command("m"))
async def cmd_m(message: Message):
    if message.from_user.id not in ADMINS:
        return

    parts = message.text.split(maxsplit=1)

    if len(parts) < 2:
        await message.answer("Использование: /m текст")
        return

    sent = 0

    for uid in list(started_users):
        try:
            await message.bot.send_message(
                uid,
                parts[1],
                parse_mode=None
            )
            sent += 1
        except Exception:
            pass

    await message.answer(f"Отправлено: {sent}")


@dp.message(Command("offers"))
async def cmd_offers(message: Message):
    if message.from_user.id not in ADMINS:
        return

    active = {
        oid: offer
        for oid, offer in offers.items()
        if offer["status"] == "pending"
    }

    if not active:
        await message.answer("Активных офферов нет.")
        return

    lines = ["Активные офферы:"]

    for oid, offer in active.items():
        lines.append(
            f"#{oid} | @{offer['creator_username']} → "
            f"{offer['recipient']} | {offer['amount']} {offer['currency']}"
        )

    await message.answer("\n".join(lines))


@dp.message()
async def track_user(message: Message):
    if not message.from_user:
        return

    if message.from_user.username:
        username_to_id[message.from_user.username.lower()] = message.from_user.id


async def main():
    if not BOT_TOKEN or ":" not in BOT_TOKEN:
        raise RuntimeError(
            "BOT_TOKEN не задан. Установите переменную окружения BOT_TOKEN "
            "в настройках Bothost."
        )

    await bot.delete_webhook(drop_pending_updates=True)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
