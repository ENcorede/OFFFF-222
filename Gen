user_langs = {}


def get_lang(uid):
    return user_langs.get(uid, "ru")


def t(uid, key, **kwargs):
    lang = get_lang(uid)
    text = TEXTS.get(lang, TEXTS["ru"]).get(
        key,
        TEXTS["ru"].get(key, key)
    )
    if kwargs:
        try:
            text = text.format(**kwargs)
        except (KeyError, IndexError):
            pass
    return text


