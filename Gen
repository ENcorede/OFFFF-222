def main_menu_kb(uid):
    lang = get_lang(uid)

    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(
            text=tr(lang, "create_offer"),
            callback_data="create_offer"
        )],
        [InlineKeyboardButton(
            text="⚙️ " + tr(lang, "settings"),
            callback_data="settings"
        )],
        [InlineKeyboardButton(
            text=tr(lang, "exit"),
            callback_data="exit"
        )],
    ])


def language_kb(prefix="lang", lang=None):
    rows = []

    for code, item in LANGUAGES.items():
        rows.append([InlineKeyboardButton(
            text=f"{item['flag']} {item['name']}",
            callback_data=f"{prefix}:{code}"
        )])

    if lang:
        rows.append([InlineKeyboardButton(
            text=tr(lang, "back"),
            callback_data="back:main"
        )])

    return InlineKeyboardMarkup(inline_keyboard=rows)


def currency_kb(uid):
    lang = get_lang(uid)
    rows = []

    for currency in ("⭐", "🪓", "🔷", "💲"):
        rows.append([InlineKeyboardButton(
            text=currency_name(currency, lang),
            callback_data=f"currency:{currency}"
        )])

    rows.append([InlineKeyboardButton(
        text=tr(lang, "back"),
        callback_data="back:link"
    )])

    return InlineKeyboardMarkup(inline_keyboard=rows)


def share_kb(oid):
    offer = offers[oid]
    lang = get_lang(offer["creator_id"])

    return InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=tr(lang, "share"),
            switch_inline_query_chosen_chat=SwitchInlineQueryChosenChat(
                query=f"offer_{oid}",
                allow_user_chats=True,
                allow_group_chats=True,
                allow_channel_chats=False,
                allow_bot_chats=False,
            )
        )
    ]])


def offer_actions_kb(oid, lang):
    return InlineKeyboardMarkup(inline_keyboard=[[
        InlineKeyboardButton(
            text=tr(lang, "reject"),
            callback_data=f"reject:{oid}"
        ),
        InlineKeyboardButton(
            text=tr(lang, "accept"),
            callback_data=f"accept:{oid}"
        ),
    ]])


def transfer_kb(oid, lang):
    return InlineKeyboardMarkup(inline_keyboard=[
        [InlineKeyboardButton(
            text=tr(lang, "transfer"),
            url=offers[oid]["link"]
        )],
        [InlineKeyboardButton(
            text=tr(lang, "confirm_transfer"),
            callback_data=f"transfer:{oid}"
        )],
    ])


# =========================================================
# PENDING OFFERS
# =========================================================

async def send_pending_offers(user_id, username):
    if not username:
        return

    normalized = username.lower().lstrip("@")
    ids = pending_offers.pop(normalized, [])

    for oid in ids:
        offer = offers.get(oid)

        if not offer or offer["status"] != "pending":
            continue

        lang = offer["offer_language"]

        try:
            await bot.send_message(
                user_id,
                e(public_offer_text(oid)),
                reply_markup=offer_actions_kb(oid, lang)
            )
        except Exception:
            pending_offers.setdefault(normalized, []).append(oid)


